#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Dev CLI for the Preflight core engine.
 *
 *   bin/preflight-analyze [--mysql=8.0.36] [--schema=schema.sql] [--stats=stats.json] [--json|--markdown] migration.sql
 *
 * schema.sql: CREATE TABLE statements (SHOW CREATE TABLE output) describing the database before the migration.
 * stats.json: {"orders": {"rows": 41200000, "data_bytes": 19756849152, "index_bytes": 6549825536}}
 * migration.sql: the SQL to analyse ("-" or omitted reads stdin).
 */

foreach ([__DIR__.'/../vendor/autoload.php', __DIR__.'/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

use Preflight\Core\Analyzer;
use Preflight\Core\Render\MarkdownRenderer;
use Preflight\Core\Render\TextRenderer;
use Preflight\Core\Report\Severity;
use Preflight\Core\Schema\SchemaSnapshot;
use Preflight\Core\Server\ServerProfile;
use Preflight\Core\Stats\StatsSet;

$options = ['mysql' => '8.0.36', 'schema' => null, 'stats' => null, 'format' => 'text'];
$file = null;
foreach (array_slice($argv, 1) as $arg) {
    if ($arg === '--json' || $arg === '--markdown') {
        $options['format'] = substr($arg, 2);
    } elseif (preg_match('/^--(mysql|schema|stats)=(.*)$/', $arg, $m)) {
        $options[$m[1]] = $m[2];
    } elseif ($arg === '-h' || $arg === '--help') {
        fwrite(STDOUT, "Usage: preflight-analyze [--mysql=8.0.36] [--schema=schema.sql] [--stats=stats.json] [--json|--markdown] migration.sql\n");
        exit(0);
    } else {
        $file = $arg;
    }
}

$read = static function (string $path): string {
    $contents = @file_get_contents($path);
    if ($contents === false) {
        fwrite(STDERR, "Cannot read {$path}\n");
        exit(2);
    }

    return $contents;
};

$sql = $file === null || $file === '-' ? (string) stream_get_contents(STDIN) : $read($file);
$schema = $options['schema'] !== null ? SchemaSnapshot::fromSql($read($options['schema'])) : null;
$stats = null;
if ($options['stats'] !== null) {
    $decoded = json_decode($read($options['stats']), true);
    if (! is_array($decoded)) {
        fwrite(STDERR, "Invalid stats JSON\n");
        exit(2);
    }
    $stats = StatsSet::fromArray($decoded);
}

try {
    $report = (new Analyzer)->analyze($sql, ServerProfile::mysql($options['mysql']), $schema, $stats);
} catch (InvalidArgumentException $e) {
    fwrite(STDERR, $e->getMessage()."\n");
    exit(2);
}

echo match ($options['format']) {
    'json' => json_encode($report->toArray(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n",
    'markdown' => (new MarkdownRenderer)->render($report),
    default => (new TextRenderer(ansi: stream_isatty(STDOUT)))->render($report),
};

exit($report->severity() === Severity::Danger ? 1 : 0);
