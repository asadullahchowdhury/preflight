#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Dev CLI for the Preflight core engine.
 *
 *   bin/preflight-analyze [--mysql=8.0.36] [--schema=schema.sql] [--stats=stats.json] [--json] migration.sql
 *
 * schema.sql: CREATE TABLE statements (SHOW CREATE TABLE output) describing the database before the migration.
 * stats.json: {"orders": {"rows": 41200000, "data_bytes": 19756849152, "index_bytes": 6549825536}}
 * migration.sql: the SQL to analyse ("-" or omitted reads stdin).
 */

foreach ([__DIR__.'/../vendor/autoload.php', __DIR__.'/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

use Preflight\Core\Analyzer;
use Preflight\Core\Report\Report;
use Preflight\Core\Report\Severity;
use Preflight\Core\Schema\SchemaSnapshot;
use Preflight\Core\Server\ServerProfile;
use Preflight\Core\Stats\StatsSet;

$options = ['mysql' => '8.0.36', 'schema' => null, 'stats' => null, 'json' => false];
$file = null;
foreach (array_slice($argv, 1) as $arg) {
    if ($arg === '--json') {
        $options['json'] = true;
    } elseif (preg_match('/^--(mysql|schema|stats)=(.*)$/', $arg, $m)) {
        $options[$m[1]] = $m[2];
    } elseif ($arg === '-h' || $arg === '--help') {
        fwrite(STDOUT, "Usage: preflight-analyze [--mysql=8.0.36] [--schema=schema.sql] [--stats=stats.json] [--json] migration.sql\n");
        exit(0);
    } else {
        $file = $arg;
    }
}

$read = static function (string $path): string {
    $contents = @file_get_contents($path);
    if ($contents === false) {
        fwrite(STDERR, "Cannot read {$path}\n");
        exit(2);
    }

    return $contents;
};

$sql = $file === null || $file === '-' ? (string) stream_get_contents(STDIN) : $read($file);
$schema = $options['schema'] !== null ? SchemaSnapshot::fromSql($read($options['schema'])) : null;
$stats = null;
if ($options['stats'] !== null) {
    $decoded = json_decode($read($options['stats']), true);
    if (! is_array($decoded)) {
        fwrite(STDERR, "Invalid stats JSON\n");
        exit(2);
    }
    $stats = StatsSet::fromArray($decoded);
}

try {
    $report = (new Analyzer)->analyze($sql, ServerProfile::mysql($options['mysql']), $schema, $stats);
} catch (InvalidArgumentException $e) {
    fwrite(STDERR, $e->getMessage()."\n");
    exit(2);
}

if ($options['json']) {
    echo json_encode($report->toArray(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), "\n";
    exit($report->severity() === Severity::Danger ? 1 : 0);
}

render($report);
exit($report->severity() === Severity::Danger ? 1 : 0);

function render(Report $report): void
{
    $color = static fn (Severity $s, string $text): string => match ($s) {
        Severity::Danger => "\033[31m{$text}\033[0m",
        Severity::Warn => "\033[33m{$text}\033[0m",
        Severity::Info => "\033[32m{$text}\033[0m",
    };
    $icon = static fn (Severity $s): string => match ($s) {
        Severity::Danger => 'DANGER',
        Severity::Warn => 'WARN  ',
        Severity::Info => 'OK    ',
    };

    echo "Preflight · MySQL {$report->serverVersion} · ".($report->sizeAware ? 'size-aware' : 'static (no table sizes)')."\n\n";

    foreach ($report->statements as $statement) {
        $sql = preg_replace('/\s+/', ' ', $statement->sql) ?? $statement->sql;
        echo $color($statement->severity(), $icon($statement->severity())).' '.(mb_strlen($sql) > 110 ? mb_substr($sql, 0, 107).'...' : $sql)."\n";
        if ($statement->effective !== null) {
            $e = $statement->effective;
            echo '        → ALGORITHM='.$e->algorithm->value.' LOCK='.$e->lock->value
                .($e->rebuildsTable() ? ' · rebuilds table' : '')
                .($e->blocksWrites() ? ' · BLOCKS WRITES' : '')
                .($statement->estimate !== null ? ' · '.$statement->estimate->format() : '')
                ."\n";
        }
        foreach ($statement->findings as $finding) {
            echo '        '.$color($finding->severity, '['.$finding->ruleId.']').' '.$finding->operation.': '.$finding->message."\n";
            if ($finding->suggestion !== null && $finding->severity !== Severity::Info) {
                echo '          ↳ '.$finding->suggestion."\n";
            }
        }
        foreach ($statement->advisories as $advisory) {
            echo '        '.$color($advisory->severity, '['.$advisory->id.']').' '.$advisory->message."\n";
        }
        echo "\n";
    }

    foreach ($report->advisories as $advisory) {
        echo $color($advisory->severity, '['.$advisory->id.']').' '.$advisory->message."\n";
    }

    echo "\nOverall: ".$color($report->severity(), strtoupper($report->severity()->value))."\n";
}
