{
    "name": "preflight/core",
    "description": "Deterministic MySQL online-DDL risk analysis for schema migrations.",
    "type": "library",
    "license": "MIT",
    "keywords": ["mysql", "migrations", "online-ddl", "schema", "linter"],
    "require": {
        "php": "^8.2",
        "phpmyadmin/sql-parser": "^5.10"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.18",
        "symfony/yaml": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Preflight\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflight\\Core\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/preflight-analyze"],
    "scripts": {
        "test": "pest",
        "test:oracle": "pest --group=oracle",
        "analyse": "phpstan analyse",
        "lint": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
