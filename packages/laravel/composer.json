{
    "name": "preflight/laravel",
    "description": "Check Laravel migrations for locking, table-copying MySQL schema changes before they reach production.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "mysql",
        "migrations",
        "online-ddl",
        "schema",
        "ci"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "preflight/core": "^0.1",
        "symfony/process": "^7.0 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true,
                "versions": {
                    "preflight/core": "0.1.x-dev"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Preflight\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflight\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Preflight\\Laravel\\PreflightServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "lint": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
